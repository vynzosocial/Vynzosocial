{
  "name": "vynzosocial-android",
  "version": "1.0.0",
  "private": true,
  "description": "VynzoSocial Android app (Capacitor 8)",
  "scripts": {
    "web": "node scripts/prepare-web.js",
    "sync": "node scripts/prepare-web.js && cap sync android",
    "ota:setup": "node scripts/ota-setup.js",
    "ota:publish": "node scripts/ota-publish.js",
    "open": "cap open android",
    "apk:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run sync && cd android && gradlew.bat assembleRelease",
    "aab:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "~8.6.0",
    "@capacitor/core": "~8.6.0",
    "@capacitor/ios": "~8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.6.0",
    "adm-zip": "^0.6.1"
  }
}
