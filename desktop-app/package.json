{
  "name": "vynzo-desktop",
  "version": "1.2.2",
  "description": "VynzoSocial Windows desktop application",
  "productName": "VynzoSocial",
  "author": "VynzoSocial",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/run-smoke.cjs",
    "build": "node scripts/build.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vynzosocial.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "shell-preload.cjs",
      "lib/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/assets/logo.png",
        "to": "logo.png"
      }
    ],
    "publish": null,
    "win": {
      "executableName": "Vynzo",
      "icon": "../frontend/assets/logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VynzoSocial-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VynzoSocial",
      "deleteAppDataOnUninstall": false
    }
  }
}
