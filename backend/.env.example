PORT=5000
# The backend rejects non-Supabase database targets.
DB_TARGET=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-or-publishable-key
SUPABASE_DATABASE_URL=-h <host-from-supabase-connect-settings> -p <port> -d postgres -U <user-from-supabase-connect-settings>
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
# Enable email confirmation in Supabase Auth and configure production SMTP in the dashboard.
