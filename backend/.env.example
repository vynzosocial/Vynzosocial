PORT=5000
DB_TARGET=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_DATABASE_URL=-h <host-from-supabase-connect-settings> -p <port> -d postgres -U <user-from-supabase-connect-settings>
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
